{
  "name": "handoff-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wwwyo/handoff-playground dev",
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p packages/overlay && tsc --noEmit -p packages/bridge"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
